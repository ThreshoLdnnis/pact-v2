# Synthetic sandbox only. This PIN is a demo identity selector, not production auth.
PACT_DEMO_PIN=246810
PACT_DATABASE_URL=sqlite:///data/pact.db
# Optional local Ollama. Leave both empty for the deterministic demo planner.
PACT_OLLAMA_URL=
PACT_OLLAMA_MODEL=
PACT_SANDBOX_CONTROLS=0
# Set a random secret of at least 24 characters to enable synthetic test controls.
PACT_SANDBOX_ADMIN_TOKEN=

# rules | ollama | openai_compatible. Explicit provider never silently falls back.
PACT_MODEL_PROVIDER=rules
# Set locally when switching to openai_compatible. Base URL normally ends in /v1.
# Request uses POST {base}/chat/completions. HTTPS required except loopback.
PACT_LLM_BASE_URL=
PACT_LLM_MODEL=
PACT_LLM_API_KEY=
# json_schema (strict) preferred; json_object for providers lacking schema support.
# Both are validated against the same closed CandidatePlan schema locally.
PACT_LLM_FORMAT=json_schema
